[Unit]
Description=OrbyMon - compactar logs NAT do A10 de dias anteriores (sem apagar)

[Service]
Type=oneshot
User=orbymon
Group=orbymon
ExecStart=/usr/bin/find /var/log/orbymon/a10nat -name "nat-events-*.tsv" -mtime +0 -exec /usr/bin/gzip -9 {} +
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/orbymon/a10nat
