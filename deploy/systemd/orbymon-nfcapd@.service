[Unit]
Description=OrbyMon pilot NetFlow/IPFIX collector (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=orbymon
Group=orbymon
EnvironmentFile=/etc/orbymon/%i.env
ExecStart=/usr/bin/nfcapd -w /var/lib/orbymon/flows/%i -p ${ORBYMON_PORT} -t 30
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/orbymon/flows/%i
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
