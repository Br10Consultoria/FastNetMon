[Unit]
Description=OrbyMon - retencao de logs NAT, spool A10 e arquivos nfcapd

[Service]
Type=oneshot
ExecStart=/opt/orbymon/scripts/orbymon-retention.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/var/log/orbymon/a10nat -/var/log/orbymon/a10 -/var/lib/orbymon/flows
