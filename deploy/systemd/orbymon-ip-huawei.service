[Unit]
Description=OrbyMon Fase 2 - pares IP do Huawei NE8000 para MariaDB
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=oneshot
User=orbymon
Group=orbymon
WorkingDirectory=/opt/orbymon
EnvironmentFile=/etc/orbymon/pipeline.env
EnvironmentFile=-/etc/orbymon/ip-analytics.env
ExecStart=/opt/orbymon/.venv/bin/python -m fmn_filters.ip_analytics --source huawei
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
