[Unit]
Description=OrbyFlow - prefixos dos ASNs de excecao (RIPEstat) e nomes de AS (RIPE)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=orbymon
Group=orbymon
WorkingDirectory=/opt/orbymon
EnvironmentFile=/etc/orbymon/pipeline.env
Environment=PYTHONPATH=/opt/orbymon/src
ExecStart=/opt/orbymon/.venv/bin/python -m fmn_filters.exceptions --sync
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orbymon/asnames
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
