[Unit]
Description=OrbyMon F4 - deteccao bidirecional passiva (entrada e saida), sem bloqueio
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=oneshot
User=orbymon
Group=orbymon
WorkingDirectory=/opt/orbymon
EnvironmentFile=/etc/orbymon/pipeline.env
ExecStart=/opt/orbymon/.venv/bin/python -m fmn_filters.bidir_detector --config /etc/orbymon/bidir.json
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
