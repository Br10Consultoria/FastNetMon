[Unit]
Description=OrbyFlow - resumo semanal de seguranca no Telegram
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=orbymon
Group=orbymon
WorkingDirectory=/opt/orbymon
EnvironmentFile=/etc/orbymon/pipeline.env
Environment=PYTHONPATH=/opt/orbymon/src
ExecStart=/opt/orbymon/.venv/bin/python -m fmn_filters.weekly_report --env-file /etc/orbymon/telegram.env
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
