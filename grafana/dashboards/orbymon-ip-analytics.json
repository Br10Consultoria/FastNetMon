      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT src_latitude AS latitude,src_longitude AS longitude,src_country AS country,src_asn AS asn,ROUND(SUM(total_bytes)/1000000,2) AS volume_mb FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) AND src_latitude IS NOT NULL AND src_longitude IS NOT NULL GROUP BY src_latitude,src_longitude,src_country,src_asn ORDER BY SUM(total_bytes) DESC LIMIT 300",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
