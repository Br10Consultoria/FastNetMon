    {
      "id": 8,
      "title": "Banda estimada por entrada ifIndex (Mbps)",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT $__timeGroupAlias(bucket_utc,'1m'),CAST(input_if AS CHAR) AS metric,ROUND(SUM(total_bytes)*8/60000000,2) AS value FROM orby_ip_pairs_minute WHERE $__timeFilter(bucket_utc) GROUP BY 1,input_if ORDER BY 1",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
