{
  "id": null,
  "uid": "orbymon-ip-analytics",
  "title": "OrbyMon | Huawei - IPs, Redes e Interfaces",
  "description": "Pares IP amostrados do Huawei. Tráfego estimado, ifIndex bruto e GeoLite2 quando disponível; não é tráfego único de clientes.",
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "tags": [
    "orbymon",
    "huawei",
    "ip",
    "netflow",
    "asn"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Ranking de IPs de origem",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT src_ip AS 'IP origem',MAX(NULLIF(src_prefix,'')) AS 'Prefixo',MAX(src_asn) AS ASN,COALESCE(MAX(NULLIF(src_asn_name,'')),'Não identificado') AS 'Organizacao',COALESCE(MAX(NULLIF(src_country,'')),'Não identificado') AS 'Pais',ROUND(SUM(total_bytes)/1000000,2) AS 'MB estimados' FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) GROUP BY src_ip ORDER BY SUM(total_bytes) DESC LIMIT 30",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MB estimados"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: MB"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Ranking de IPs de destino",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT dst_ip AS 'IP destino',MAX(NULLIF(dst_prefix,'')) AS 'Prefixo',MAX(dst_asn) AS ASN,COALESCE(MAX(NULLIF(dst_asn_name,'')),'Não identificado') AS 'Organizacao',COALESCE(MAX(NULLIF(dst_country,'')),'Não identificado') AS 'Pais',ROUND(SUM(total_bytes)/1000000,2) AS 'MB estimados' FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) GROUP BY dst_ip ORDER BY SUM(total_bytes) DESC LIMIT 30",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MB estimados"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: MB"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Pares origem e destino / principais portas",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 15,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT src_ip AS 'Origem',dst_ip AS 'Destino',protocol AS 'Protocolo',dst_port AS 'Porta',CASE WHEN input_if=0 THEN 'Não informado' ELSE COALESCE(MAX(im_in.if_name),CONCAT('ifIndex ',input_if)) END AS 'Entrada Huawei',CASE WHEN output_if=0 THEN 'Não informado' ELSE COALESCE(MAX(im_out.if_name),CONCAT('ifIndex ',output_if)) END AS 'Saída Huawei',ROUND(SUM(total_bytes)/1000000,2) AS 'MB estimados' FROM orby_ip_pairs_minute LEFT JOIN orby_interface_names AS im_in ON im_in.source='huawei' AND im_in.if_index=input_if LEFT JOIN orby_interface_names AS im_out ON im_out.source='huawei' AND im_out.if_index=output_if WHERE orby_ip_pairs_minute.source='huawei' AND $__timeFilter(bucket_utc) GROUP BY src_ip,dst_ip,protocol,dst_port,input_if,output_if ORDER BY SUM(total_bytes) DESC LIMIT 40",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MB estimados"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: MB"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Interfaces Huawei (ifName confirmado ou ifIndex)",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 15,
        "y": 9,
        "w": 9,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT CASE WHEN input_if=0 THEN 'Não informado' ELSE COALESCE(MAX(im_in.if_name),CONCAT('ifIndex ',input_if)) END AS 'Entrada Huawei',CASE WHEN output_if=0 THEN 'Não informado' ELSE COALESCE(MAX(im_out.if_name),CONCAT('ifIndex ',output_if)) END AS 'Saída Huawei',netflow_direction AS 'Direcao raw',ROUND(SUM(total_bytes)/1000000,2) AS 'MB estimados',SUM(flow_records) AS 'Registros' FROM orby_ip_pairs_minute LEFT JOIN orby_interface_names AS im_in ON im_in.source='huawei' AND im_in.if_index=input_if LEFT JOIN orby_interface_names AS im_out ON im_out.source='huawei' AND im_out.if_index=output_if WHERE orby_ip_pairs_minute.source='huawei' AND $__timeFilter(bucket_utc) GROUP BY input_if,output_if,netflow_direction ORDER BY SUM(total_bytes) DESC LIMIT 30",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MB estimados"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: MB"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {}
    },
