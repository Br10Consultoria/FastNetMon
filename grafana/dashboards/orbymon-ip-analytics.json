          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.asn AS 'ASN',t.nome AS 'Nome',t.ip AS 'IP destino',t.bloco AS 'Bloco',COALESCE(cn.name,NULLIF(t.pais,''),'Não informado') AS 'País',t.vol AS 'Volume',t.bps AS 'Taxa média',t.pps AS 'Pacotes/s médio' FROM (SELECT dst_ip AS ip,MAX(dst_asn) AS asn,COALESCE(MAX(NULLIF(dst_asn_name,'')),'Não identificado') AS nome,COALESCE(MAX(NULLIF(dst_prefix,'')),'—') AS bloco,MAX(NULLIF(dst_country,'')) AS pais,SUM(total_bytes) AS vol,SUM(total_bytes)*8/GREATEST(1,$__unixEpochTo()-$__unixEpochFrom()) AS bps,SUM(total_packets)/GREATEST(1,$__unixEpochTo()-$__unixEpochFrom()) AS pps FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) GROUP BY dst_ip ORDER BY SUM(total_bytes) DESC LIMIT 30) AS t LEFT JOIN orby_country_names AS cn ON cn.code=t.pais ORDER BY t.vol DESC"
