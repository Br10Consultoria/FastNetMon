          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT MAX(100*GREATEST(tcp_ports,udp_ports)/capacity) AS value FROM orby_nat_public_minute WHERE bucket_utc=(SELECT MAX(bucket_utc) FROM orby_nat_public_minute WHERE $__timeFilter(bucket_utc))"
