    {
      "id": 7,
      "title": "Mapa de alertas DDoS — apenas quando houver alertas",
      "type": "geomap",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT a.src_latitude AS latitude,a.src_longitude AS longitude,COALESCE(cn.name,NULLIF(a.src_country,''),'Não informado') AS 'País',a.src_asn AS 'ASN',a.src_asn_name AS 'Nome',a.src_ip AS 'IP origem',a.dst_ip AS 'IP destino',a.rule_name AS 'Regra',a.pps AS 'Pacotes/s',a.event_time AS 'Data UTC' FROM orby_alerts AS a LEFT JOIN orby_country_names AS cn ON cn.code=a.src_country WHERE $__timeFilter(a.event_time) AND a.src_ip IS NOT NULL AND a.src_latitude IS NOT NULL AND a.src_longitude IS NOT NULL ORDER BY a.event_time DESC LIMIT 3000",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "padding": 10,
          "maxZoom": 6,
          "lat": -14,
          "lon": -51,
          "zoom": 3
        },
        "basemap": {
          "type": "default",
          "name": "Open Street Map"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Alertas por origem (IP)",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "tooltip": true,
            "config": {
              "style": {
                "size": {
                  "fixed": 7,
                  "min": 5,
                  "max": 26
                },
                "color": {
                  "fixed": "#E02F44"
                },
                "opacity": 0.7,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              },
              "showLegend": true
            }
          }
        ],
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pacotes/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pps"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "description": "Este painel mostra apenas incidentes com IP de origem geolocalizado. Ficar vazio quando não existem alertas é esperado."
    },
    {
      "id": 8,
      "title": "Top ASNs de origem — Huawei (enriquecido)",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 15,
        "y": 12,
        "w": 9,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT t.asn AS 'ASN',t.nome AS 'Nome',t.blocos AS 'Blocos / IPs',t.ips AS 'IPs',CASE WHEN t.paises>1 THEN 'Vários' ELSE COALESCE(cn.name,NULLIF(t.pais,''),'Não informado') END AS 'País',t.vol AS 'Volume',t.bps AS 'Taxa média',t.pps AS 'Pacotes/s médio' FROM (SELECT src_asn AS asn,COALESCE(MAX(NULLIF(src_asn_name,'')),'Não identificado') AS nome,COALESCE(NULLIF(GROUP_CONCAT(DISTINCT NULLIF(src_prefix,'') ORDER BY src_prefix SEPARATOR ', ' LIMIT 3),''),GROUP_CONCAT(DISTINCT src_ip ORDER BY src_ip SEPARATOR ', ' LIMIT 3)) AS blocos,COUNT(DISTINCT src_ip) AS ips,COUNT(DISTINCT NULLIF(src_country,'')) AS paises,MAX(NULLIF(src_country,'')) AS pais,SUM(total_bytes) AS vol,SUM(total_bytes)*8/GREATEST(1,$__unixEpochTo()-$__unixEpochFrom()) AS bps,SUM(total_packets)/GREATEST(1,$__unixEpochTo()-$__unixEpochFrom()) AS pps FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) AND src_asn>0 GROUP BY src_asn ORDER BY SUM(total_bytes) DESC LIMIT 25) AS t LEFT JOIN orby_country_names AS cn ON cn.code=t.pais ORDER BY t.vol DESC",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Volume"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Taxa média"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pacotes/s médio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
