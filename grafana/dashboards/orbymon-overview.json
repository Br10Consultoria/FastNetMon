            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT ROUND(COALESCE(SUM(total_bytes),0),0) AS value FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc)",
          "format": "table",
          "editorMode": "code"
