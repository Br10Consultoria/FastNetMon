          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Taxa estimada por protocolo — Huawei",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 15,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT $__timeGroupAlias(bucket_utc,'1m'),protocol AS metric,ROUND(SUM(total_bytes)*8/60,3) AS value FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) GROUP BY 1,protocol ORDER BY 1",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
