              "options": "Pico taxa"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipos"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              }
            ]
          }
        ]
      },
      "transparent": true,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT IF(subscriber_ip='',local_ip,subscriber_ip) AS 'Assinante / IP',MAX(local_ip) AS 'IP público',MAX(pool) AS 'Pool',COUNT(*) AS 'Eventos',GROUP_CONCAT(DISTINCT rule_name ORDER BY rule_name SEPARATOR ', ') AS 'Tipos',MAX(IF(detection='nat',NULL,pps)) AS 'Pico pps',MAX(IF(detection='nat',NULL,mbps))*1000000 AS 'Pico taxa',MAX(CAST(JSON_VALUE(details,'$.active_ports') AS UNSIGNED)) AS 'Portas NAT ativas (máx)',MAX(CAST(JSON_VALUE(details,'$.allocs_per_min') AS UNSIGNED)) AS 'Alocações NAT/min (máx)',MIN(event_time) AS 'Primeiro (UTC)',MAX(event_time) AS 'Último (UTC)' FROM orby_attack_events WHERE $__timeFilter(event_time) AND direction='out' AND (${ip:sqlstring}='' OR local_ip=${ip:sqlstring} OR subscriber_ip=${ip:sqlstring}) GROUP BY IF(subscriber_ip='',local_ip,subscriber_ip) ORDER BY COUNT(*) DESC LIMIT 100"
        }
      ],
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      }
    },
