    {
      "id": 5,
      "type": "table",
      "title": "Assinantes que mais ocupam portas — agora",
      "description": "Rotatividade = portas novas por minuto sobre as portas abertas. Alta (dezenas de %) = abre e fecha sem parar: típico de bot/varredura. Baixa com muitas portas = conexões longas (P2P, muitos aparelhos). Para ver um assinante, digite o IP no filtro do topo.",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT h.inside_ip AS 'Assinante (IP privado)',h.public_ip AS 'IP público',h.pool AS 'Pool',h.tcp_ports AS 'Portas TCP',h.udp_ports AS 'Portas UDP',h.share_pct AS 'Ocupa do IP (%)',u.allocs AS 'Alocações/min',ROUND(u.allocs/GREATEST(1,u.active_ports)*100,1) AS 'Rotatividade (%/min)' FROM orby_nat_heavy_minute h LEFT JOIN orby_nat_user_minute u ON u.inside_ip=h.inside_ip AND u.bucket_utc=h.bucket_utc WHERE h.bucket_utc=(SELECT MAX(bucket_utc) FROM orby_nat_heavy_minute WHERE $__timeFilter(bucket_utc)) ORDER BY GREATEST(h.tcp_ports,h.udp_ports) DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ocupa do IP (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 60,
                      "color": "yellow"
                    },
                    {
                      "value": 80,
                      "color": "orange"
                    },
                    {
                      "value": 95,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Pico no período por assinante",
      "description": "Quem passa mais tempo com muitas portas: candidato a contato do suporte (equipamento infectado, P2P) ou a uma cota por assinante no A10.",
