    {
      "id": 7,
      "type": "timeseries",
      "title": "Portas abertas — 10 assinantes que mais ocupam",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
