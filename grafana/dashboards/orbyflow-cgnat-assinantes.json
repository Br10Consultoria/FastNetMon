            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT inside_ip AS 'Assinante (IP privado)',MAX(public_ip) AS 'IP público',MAX(GREATEST(tcp_ports,udp_ports)) AS 'Portas (máx)',MAX(share_pct) AS 'Ocupa do IP (máx %%)',SUM(GREATEST(tcp_ports,udp_ports)>=10000) AS 'Minutos com 10 mil+',COUNT(*) AS 'Minutos com 1.000+' FROM orby_nat_heavy_minute WHERE $__timeFilter(bucket_utc) GROUP BY inside_ip ORDER BY 3 DESC LIMIT 50"
        }
      ],
