    {
      "id": 9,
      "type": "table",
      "title": "Alertas de NAT (detecção)",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event_time AS 'Hora',rule_name AS 'Regra',severity AS 'Severidade',subscriber_ip AS 'Assinante',COALESCE(JSON_VALUE(details,'$.public_ips[0]'),'') AS 'IP público',CAST(JSON_VALUE(details,'$.allocs_per_min') AS UNSIGNED) AS 'Alocações/min',CAST(JSON_VALUE(details,'$.active_ports') AS UNSIGNED) AS 'Portas ativas',COALESCE(CONCAT(JSON_VALUE(details,'$.top_portas[0].protocolo'),'/',JSON_VALUE(details,'$.top_portas[0].porta'),' → ',JSON_VALUE(details,'$.top_portas[0].destinos'),' destinos'),'') AS 'Principal saída' FROM orby_attack_events WHERE detection='nat' AND $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Assinante selecionado: portas abertas e alocações/min",
      "description": "Digite o IP privado no filtro 'Assinante' no topo.",
      "datasource": {
        "type": "mysql",
