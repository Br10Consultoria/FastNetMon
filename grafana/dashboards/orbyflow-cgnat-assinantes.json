    {
      "id": 12,
      "type": "table",
      "title": "Assinante selecionado: para onde ele sai (fluxos amostrados, últimos 2 dias)",
      "description": "Muitos destinos distintos na mesma porta (23, 22, 445, 3389) = varredura. Portas altas e variadas com poucos destinos = P2P.",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 12,
        "y": 58,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT protocol AS 'Proto',remote_port AS 'Porta destino',COUNT(DISTINCT remote_ip) AS 'Destinos distintos',SUM(packets) AS 'Pacotes (estim.)',SUM(bytes) AS 'Bytes (estim.)' FROM orby_flow_minute WHERE subscriber_ip=${assinante:sqlstring} AND direction='out' AND $__timeFilter(bucket_utc) GROUP BY protocol,remote_port ORDER BY 3 DESC LIMIT 20"
        }
      ],
      "options": {
