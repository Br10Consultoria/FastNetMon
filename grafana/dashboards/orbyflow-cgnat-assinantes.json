      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(h.bucket_utc,'1m'),h.inside_ip AS metric,GREATEST(h.tcp_ports,h.udp_ports) AS value FROM orby_nat_heavy_minute h JOIN (SELECT inside_ip FROM orby_nat_heavy_minute WHERE $__timeFilter(bucket_utc) GROUP BY inside_ip ORDER BY MAX(GREATEST(tcp_ports,udp_ports)) DESC LIMIT 10) t ON t.inside_ip=h.inside_ip WHERE $__timeFilter(h.bucket_utc) ORDER BY 1"
        }
      ],
      "options": {
