          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(bucket_utc,'1m'),'portas abertas' AS metric,active_ports AS value FROM orby_nat_user_minute WHERE inside_ip=${assinante:sqlstring} AND $__timeFilter(bucket_utc) UNION ALL SELECT $__timeGroupAlias(bucket_utc,'1m'),'alocações/min',allocs FROM orby_nat_user_minute WHERE inside_ip=${assinante:sqlstring} AND $__timeFilter(bucket_utc) ORDER BY 1"
