    {
      "id": 3,
      "title": "Top 20 ASN origem",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT src_asn AS ASN, ROUND(SUM(total_bytes)/1000000,2) AS MB FROM orby_traffic_minute WHERE $__timeFilter(bucket_utc) AND src_asn > 0 GROUP BY src_asn ORDER BY SUM(total_bytes) DESC LIMIT 20",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Top portas TCP/UDP",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT protocol, dst_port, ROUND(SUM(total_bytes)/1000000,2) AS MB FROM orby_traffic_minute WHERE $__timeFilter(bucket_utc) AND dst_port>0 AND protocol IN ('tcp','udp') GROUP BY protocol,dst_port ORDER BY SUM(total_bytes) DESC LIMIT 20",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
