    {
      "id": 9,
      "title": "Fluxos Huawei por minuto — amostrados",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
