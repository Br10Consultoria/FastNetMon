    {
      "id": 1,
      "title": "Banda estimada em Mbps por protocolo",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT $__timeGroupAlias(bucket_utc,'1m'), protocol AS metric, ROUND(SUM(total_bytes)*8/60000000,2) AS value FROM orby_traffic_minute WHERE $__timeFilter(bucket_utc) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "PPS estimados por protocolo",
