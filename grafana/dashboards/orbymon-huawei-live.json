          },
          "rawSql": "SELECT $__timeGroupAlias(bucket_utc,'1m'),protocol AS metric,SUM(flow_records) AS value FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) GROUP BY 1,protocol ORDER BY 1",
          "format": "time_series",
          "editorMode": "code"
