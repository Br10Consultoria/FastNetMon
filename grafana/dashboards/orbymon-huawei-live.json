    {
      "id": 10,
      "title": "Minutos recentes processados (UTC)",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT bucket_utc AS 'Minuto UTC',protocol AS Protocolo,ROUND(SUM(total_bytes)*8/60000000,3) AS 'Mbps estimados',ROUND(SUM(total_packets)/60,1) AS 'PPS estimados',SUM(flow_records) AS 'Fluxos' FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) GROUP BY bucket_utc,protocol ORDER BY bucket_utc DESC LIMIT 60",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Mapa de tráfego observado — GeoLite2 (não são alertas)",
      "type": "geomap",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT src_latitude AS latitude,src_longitude AS longitude,MAX(src_country) AS country,src_asn AS asn,MAX(NULLIF(src_asn_name,'')) AS operator_name,COUNT(DISTINCT src_ip) AS source_ips,ROUND(SUM(total_bytes)/1000000,2) AS volume_mb FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) AND src_latitude IS NOT NULL AND src_longitude IS NOT NULL GROUP BY src_latitude,src_longitude,src_asn ORDER BY SUM(total_bytes) DESC LIMIT 300",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 0,
          "lon": 0,
          "zoom": 1
        },
        "basemap": {
          "type": "default",
          "name": "Open Street Map"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Tráfego Huawei (localização GeoIP aproximada)",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "tooltip": true,
            "config": {
              "style": {
                "size": {
                  "fixed": 9
                },
                "color": {
                  "fixed": "#FF891A"
                }
              }
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "Origens públicas observadas no NetFlow Huawei, localizadas aproximadamente pela GeoLite2. Não são alertas nem locais exatos. A atualização depende da importação nfcapd → MariaDB."
    },
    {
      "id": 12,
      "title": "Países e origens observadas",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 16,
        "y": 38,
        "w": 8,
        "h": 12
      },
      "description": "País e coordenadas aproximados da base GeoLite2 para IPs públicos",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT src_country AS País,COUNT(DISTINCT src_ip) AS 'IPs de origem',ROUND(SUM(total_bytes)/1000000,2) AS 'MB estimados' FROM orby_ip_pairs_minute WHERE source='huawei' AND $__timeFilter(bucket_utc) AND src_country<>'' GROUP BY src_country ORDER BY SUM(total_bytes) DESC LIMIT 20",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MB estimados"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: MB"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Mbps estimados por interface Huawei (entrada)",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 16,
        "h": 9
      },
      "description": "Interfaces SNMP ifName confirmadas; 'Não informado' corresponde ao ifIndex 0. A direção bruta do NetFlow não corresponde necessariamente a upload/download.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT $__timeGroupAlias(bucket_utc,'1m'),CASE WHEN input_if=0 THEN 'Não informado' ELSE COALESCE(CONCAT(im.if_name,' (',input_if,')'),CONCAT('ifIndex ',input_if)) END AS metric,ROUND(SUM(total_bytes)*8/60000000,3) AS value FROM orby_ip_pairs_minute AS p LEFT JOIN orby_interface_names AS im ON im.source=p.source AND im.if_index=p.input_if WHERE p.source='huawei' AND $__timeFilter(p.bucket_utc) GROUP BY 1,p.input_if,im.if_name ORDER BY 1",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Mbps",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Atraso de coleta Huawei (min)",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 16,
        "y": 50,
        "w": 8,
        "h": 4
      },
      "description": "Baseado no último bucket de fluxo UTC, independente da janela do dashboard; não mede diretamente latência de rede.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT ROUND(TIMESTAMPDIFF(SECOND,MAX(bucket_utc),UTC_TIMESTAMP())/60,1) AS value FROM orby_ip_pairs_minute WHERE source='huawei'",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: min",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 15,
      "title": "Última amostra Huawei (UTC)",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "gridPos": {
        "x": 16,
        "y": 54,
        "w": 8,
        "h": 5
      },
      "description": "Bucket do fim do fluxo registrado no MariaDB; caso timestamps de fluxo estejam incorretos, este valor também estará.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT UNIX_TIMESTAMP(MAX(bucket_utc)) AS value FROM orby_ip_pairs_minute WHERE source='huawei'",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "description": "Visão quase em tempo real de NetFlow Huawei: taxa estimada por minuto a partir de buckets do fim do fluxo (amostragem/sampling), GeoLite2 offline e atualização Grafana de 30s. Não é captura instantânea nem detector de ataque."
}
