          },
          "rawSql": "SELECT $__timeGroupAlias(bucket_utc,'1m'), protocol AS metric, ROUND(SUM(total_packets)/60,0) AS value FROM orby_traffic_minute WHERE $__timeFilter(bucket_utc) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code"
