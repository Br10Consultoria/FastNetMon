            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM orby_attack_events WHERE direction='in' AND detection IN ('flow','filter') AND $__timeFilter(event_time)"
