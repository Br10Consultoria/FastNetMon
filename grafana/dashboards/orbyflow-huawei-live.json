    {
      "id": 3,
      "type": "table",
      "title": "Top 20 ASNs observados (ASN, nome, blocos, país)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "links": [],
      "options": {
        "cellHeight": "sm",
