          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT cpe_ip) AS value FROM orby_threat_hits WHERE category='bot' AND last_seen>=$__timeFrom() AND first_seen<=$__timeTo() AND (${ip:sqlstring}='' OR cpe_ip=${ip:sqlstring} OR remote_ip=${ip:sqlstring} OR public_ip=${ip:sqlstring})"
