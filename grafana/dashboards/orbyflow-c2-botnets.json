          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(malware,''),'(sem família informada)') AS 'Malware',COUNT(DISTINCT cpe_ip) AS 'Clientes',COUNT(DISTINCT remote_ip) AS 'IPs de C2',MAX(last_seen) AS 'Último contato (UTC)' FROM orby_threat_hits WHERE category='bot' AND last_seen>=$__timeFrom() AND first_seen<=$__timeTo() AND (${ip:sqlstring}='' OR cpe_ip=${ip:sqlstring} OR remote_ip=${ip:sqlstring} OR public_ip=${ip:sqlstring}) GROUP BY 1 ORDER BY 2 DESC LIMIT 30"
