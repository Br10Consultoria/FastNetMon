          "rawSql": "SELECT cpe_ip AS 'Cliente',NULLIF(public_ip,cpe_ip) AS 'IP público',NULLIF(pool,'') AS 'Pool',remote_ip AS 'IP listado',CONCAT(UPPER(CONVERT(protocol USING utf8mb4)),'/',IF(remote_port>0,remote_port,IF(listed_port>0,listed_port,'—'))) AS 'Porta',sources AS 'Listas',NULLIF(malware,'') AS 'Malware',flows AS 'Fluxos',bytes AS 'Volume (estim.)',first_seen AS 'Primeiro contato (UTC)',last_seen AS 'Último contato (UTC)' FROM orby_threat_hits WHERE category='reputacao' AND last_seen>=$__timeFrom() AND first_seen<=$__timeTo() AND (${ip:sqlstring}='' OR cpe_ip=${ip:sqlstring} OR remote_ip=${ip:sqlstring} OR public_ip=${ip:sqlstring}) ORDER BY bytes DESC LIMIT 500"
        }
