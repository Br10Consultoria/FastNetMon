    {
      "id": 5,
      "type": "table",
      "title": "Clientes falando com C2/botnet",
      "description": "Servidor de comando de malware: o equipamento do cliente (roteador, câmera, PC) provavelmente está infectado. Também vira alerta em Ataques e no Telegram (uma vez por dia por par).",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cpe_ip AS 'Cliente',NULLIF(public_ip,cpe_ip) AS 'IP público',NULLIF(pool,'') AS 'Pool',remote_ip AS 'IP listado',CONCAT(UPPER(CONVERT(protocol USING utf8mb4)),'/',IF(remote_port>0,remote_port,IF(listed_port>0,listed_port,'—'))) AS 'Porta',sources AS 'Listas',NULLIF(malware,'') AS 'Malware',flows AS 'Fluxos',bytes AS 'Volume (estim.)',first_seen AS 'Primeiro contato (UTC)',last_seen AS 'Último contato (UTC)' FROM orby_threat_hits WHERE category='bot' AND last_seen>=$__timeFrom() AND first_seen<=$__timeTo() AND (${ip:sqlstring}='' OR cpe_ip=${ip:sqlstring} OR remote_ip=${ip:sqlstring} OR public_ip=${ip:sqlstring}) ORDER BY last_seen DESC LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Volume (estim.)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          }
        ]
      }
    },
