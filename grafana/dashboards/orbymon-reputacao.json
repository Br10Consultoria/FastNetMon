    {
      "id": 6,
      "title": "IPs do provedor em listas de bloqueio (agora)",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "description": "Atualizado de hora em hora (DNSBL e AbuseIPDB a cada 6 h). Provável responsável = assinante com mais fluxos de saída para as portas típicas do abuso nas últimas 48 h.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT entry AS 'IP / bloco',CASE scope WHEN 'cgnat_pool' THEN CONCAT('pool CGNAT ',pool) WHEN 'dedicated' THEN 'IP dedicado' WHEN 'infra' THEN 'infraestrutura' ELSE scope END AS 'Tipo',GROUP_CONCAT(DISTINCT source_label ORDER BY source_label SEPARATOR ', ') AS 'Listas',GROUP_CONCAT(DISTINCT category ORDER BY category SEPARATOR '; ') AS 'Motivo',MAX(COALESCE(JSON_UNQUOTE(JSON_EXTRACT(detail,'$.suspeitos[0].ip')),JSON_UNQUOTE(JSON_EXTRACT(detail,'$.eventos[0].ip')),'')) AS 'Provável responsável',MIN(first_seen) AS 'Listado desde (UTC)',MAX(last_seen) AS 'Visto (UTC)' FROM orby_reputation_listings WHERE removed_at IS NULL AND (${ip:sqlstring}='' OR entry=${ip:sqlstring} OR JSON_SEARCH(detail,'one',${ip:sqlstring}) IS NOT NULL) GROUP BY entry,scope,pool ORDER BY COUNT(*) DESC,entry LIMIT 200",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "IP / bloco"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Provável responsável"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Quem mais originou ataques (assinante ou IP dedicado)",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "orbymon-mysql"
      },
      "description": "IP privado 100.64.x = assinante CGNAT (identificado pelo log NAT do A10). Os eventos ficam guardados.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbymon-mysql"
          },
          "rawSql": "SELECT IF(subscriber_ip='',local_ip,subscriber_ip) AS 'Assinante / IP',MAX(local_ip) AS 'IP público',MAX(pool) AS 'Pool',COUNT(*) AS 'Eventos',GROUP_CONCAT(DISTINCT rule_name ORDER BY rule_name SEPARATOR ', ') AS 'Tipos',MAX(pps) AS 'Pico pps',MAX(mbps)*1000000 AS 'Pico taxa',MIN(event_time) AS 'Primeiro (UTC)',MAX(event_time) AS 'Último (UTC)' FROM orby_attack_events WHERE $__timeFilter(event_time) AND direction='out' AND (${ip:sqlstring}='' OR local_ip=${ip:sqlstring} OR subscriber_ip=${ip:sqlstring}) GROUP BY IF(subscriber_ip='',local_ip,subscriber_ip) ORDER BY COUNT(*) DESC LIMIT 100",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pico pps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pps"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pico taxa"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipos"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              }
            ]
          }
        ]
      },
      "options": {}
    },
