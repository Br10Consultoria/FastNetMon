            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Minutos em que a condição casou",
      "description": "1 = a condição do alarme foi atendida naquele minuto. O incidente abre depois dos 'minutos seguidos' configurados no alarme.",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
