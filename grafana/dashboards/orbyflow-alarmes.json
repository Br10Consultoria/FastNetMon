    {
      "id": 5,
      "type": "table",
      "title": "Alarmes agora",
      "description": "Situação 'normal' = a medida está abaixo do limite ('Dispara quando'); nenhum ataque. Taxa = quanto do tráfego casa com o filtro agora (tráfego legítimo também casa: respostas DNS, NTP...). 'INCIDENTE' = passou do limite pelos minutos seguidos; aí o quadro 'Incidentes no período' mostra hora, IPs atacados e de onde veio. Liga/desliga e limites: painel web > Alarmes.",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.name AS 'Alarme',IF(r.enabled,'ligado','desligado') AS 'Ligado',CASE WHEN NOT r.enabled THEN '—' WHEN s.status='open' THEN 'INCIDENTE' WHEN s.status='cooling' THEN 'resfriando' WHEN s.last_bucket IS NULL THEN 'aguardando' ELSE 'normal' END AS 'Situação',CASE r.direction WHEN 'in' THEN 'recebido' WHEN 'out' THEN 'originado' ELSE 'ambos' END AS 'Sentido',r.severity AS 'Severidade',CONCAT(CASE JSON_VALUE(r.definition,'$.conditions[0].metric') WHEN 'mbps' THEN 'Mbps' WHEN 'pps' THEN 'pacotes/s' WHEN 'flows' THEN 'fluxos/min' ELSE JSON_VALUE(r.definition,'$.conditions[0].metric') END,' ',CASE JSON_VALUE(r.definition,'$.conditions[0].op') WHEN 'gt' THEN '>' WHEN 'lt' THEN '<' ELSE JSON_VALUE(r.definition,'$.conditions[0].op') END,' ',JSON_VALUE(r.definition,'$.conditions[0].value'),IF(JSON_LENGTH(r.definition,'$.conditions')>1,' (+ outras)',''),' · ',JSON_VALUE(r.definition,'$.consecutive'),' min') AS 'Dispara quando',(SELECT MAX(i.started_at) FROM orby_filter_incidents i WHERE i.rule_id=r.id) AS 'Último incidente (UTC)',s.last_bucket AS 'Último minuto (UTC)',s.last_bps AS 'Taxa',s.last_pps AS 'Pacotes/s',s.last_flows AS 'Fluxos/min',NULLIF(s.last_error,'') AS 'Erro',r.expr AS 'Filtro' FROM orby_filter_rules r LEFT JOIN orby_filter_rule_state s ON s.rule_id=r.id ORDER BY r.enabled DESC,(s.status='open') DESC,r.name"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Taxa"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pacotes/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pps"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Incidentes no período",
      "description": "Top = quem mais pesou no alarme (destino, origem, porta... conforme o relatório do alarme). Detalhe por IP: painel web > Ataques (tipo 'Filtro: ...').",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT i.rule_name AS 'Alarme',i.severity AS 'Severidade',CASE i.status WHEN 'open' THEN 'aberto' WHEN 'cooling' THEN 'resfriando' ELSE 'encerrado' END AS 'Situação',i.started_at AS 'Início (UTC)',i.resolved_at AS 'Fim (UTC)',TIMESTAMPDIFF(MINUTE,i.started_at,COALESCE(i.resolved_at,UTC_TIMESTAMP())) AS 'Duração (min)',i.peak_bps AS 'Pico taxa',i.peak_pps AS 'Pico pacotes/s',i.matches AS 'Minutos casados',CONCAT_WS(', ',JSON_VALUE(i.top,'$[0].key'),JSON_VALUE(i.top,'$[1].key'),JSON_VALUE(i.top,'$[2].key')) AS 'Top (IPs/portas)',COALESCE(JSON_VALUE(i.top,'$[0].assinantes[0]'),JSON_VALUE(i.top,'$[1].assinantes[0]'),JSON_VALUE(i.top,'$[2].assinantes[0]')) AS 'Assinante (CGNAT)' FROM orby_filter_incidents i WHERE i.rule_id IN (${alarme:csv}) AND i.started_at<$__timeTo() AND (i.resolved_at IS NULL OR i.resolved_at>=$__timeFrom()) ORDER BY i.started_at DESC LIMIT 300"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          },
          "noValue": "Nenhum incidente no período: nenhum alarme passou do limite."
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pico taxa"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pico pacotes/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pps"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Taxa medida por alarme (Mbps)",
      "description": "O que cada alarme mediu minuto a minuto (soma do tráfego que casa com o filtro, normal ou não). Só vira incidente quando passa do limite do alarme; compare com a coluna 'Dispara quando' acima.",
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(x.bucket_utc,'1m'),r.name AS metric,x.bps/1000000 AS value FROM orby_filter_rule_samples x JOIN orby_filter_rules r ON r.id=x.rule_id WHERE r.id IN (${alarme:csv}) AND $__timeFilter(x.bucket_utc) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbps",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
