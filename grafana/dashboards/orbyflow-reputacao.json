    {
      "id": 6,
      "type": "table",
      "title": "IPs do provedor em listas de bloqueio (agora)",
      "description": "Atualizado de hora em hora (DNSBL e AbuseIPDB a cada 6 h). Provável responsável = assinante com mais fluxos de saída para as portas típicas do abuso nas últimas 48 h.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 9
      },
      "links": [],
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "zebraStriping": false
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            },
            "filterable": true,
            "footer": {
              "reducers": []
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "IP / bloco"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Provável responsável"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "transparent": true,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT entry AS 'IP / bloco',CASE scope WHEN 'cgnat_pool' THEN CONCAT('pool CGNAT ',pool) WHEN 'dedicated' THEN 'IP dedicado' WHEN 'infra' THEN 'infraestrutura' ELSE scope END AS 'Tipo',GROUP_CONCAT(DISTINCT source_label ORDER BY source_label SEPARATOR ', ') AS 'Listas',GROUP_CONCAT(DISTINCT category ORDER BY category SEPARATOR '; ') AS 'Motivo',MAX(COALESCE(JSON_UNQUOTE(JSON_EXTRACT(detail,'$.suspeitos[0].ip')),JSON_UNQUOTE(JSON_EXTRACT(detail,'$.eventos[0].ip')),'')) AS 'Provável responsável',MIN(first_seen) AS 'Listado desde (UTC)',MAX(last_seen) AS 'Visto (UTC)' FROM orby_reputation_listings WHERE removed_at IS NULL AND (${ip:sqlstring}='' OR entry=${ip:sqlstring} OR JSON_SEARCH(detail,'one',${ip:sqlstring}) IS NOT NULL) GROUP BY entry,scope,pool ORDER BY COUNT(*) DESC,entry LIMIT 200"
        }
      ],
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      }
    },
    {
      "id": 12,
