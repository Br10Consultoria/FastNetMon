    {
      "id": 13,
      "type": "table",
      "title": "Listagens ativas por lista",
      "description": "Em quais listas os IPs do provedor estão agora. Listas de spam (Spamhaus, SpamCop, Barracuda) afetam e-mail; listas de ataque/botnet (FireHOL, IPsum, AbuseIPDB) podem bloquear navegação.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "links": [],
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "transparent": false,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source_label AS 'Lista',COUNT(DISTINCT entry) AS 'IPs/blocos listados',SUM(scope='cgnat_pool') AS 'De pool CGNAT',MIN(first_seen) AS 'Listado desde (mais antigo)',MAX(last_seen) AS 'Última confirmação' FROM orby_reputation_listings WHERE removed_at IS NULL GROUP BY source_label ORDER BY 2 DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Entradas e saídas das listas por dia",
      "description": "Listagens novas e removidas por dia. Muitas entradas seguidas indicam um cliente infectado ativo: veja o dashboard de ataques originados.",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "links": [],
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
      },
      "transparent": false,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(first_seen,'1d'),'entrou' AS metric,COUNT(*) AS value FROM orby_reputation_listings WHERE $__timeFilter(first_seen) GROUP BY 1 UNION ALL SELECT $__timeGroupAlias(removed_at,'1d'),'saiu',COUNT(*) FROM orby_reputation_listings WHERE removed_at IS NOT NULL AND $__timeFilter(removed_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    }
