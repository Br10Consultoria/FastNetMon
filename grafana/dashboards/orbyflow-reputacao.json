          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT entry AS 'IP / bloco',source_label AS 'Lista',category AS 'Motivo',first_seen AS 'Desde (UTC)',removed_at AS 'Saiu (UTC)' FROM orby_reputation_listings WHERE removed_at IS NOT NULL AND (${ip:sqlstring}='' OR entry=${ip:sqlstring}) ORDER BY removed_at DESC LIMIT 200"
        }
