      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "orbyflow-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source AS 'Fonte',status AS 'Situação',last_ok AS 'Última com sucesso (UTC)',entries AS 'Entradas',matched AS 'Nos seus blocos',error AS 'Erro' FROM orby_reputation_sources ORDER BY status DESC,source"
        }
      ],
      "datasource": {
        "type": "mysql",
        "uid": "orbyflow-mysql"
