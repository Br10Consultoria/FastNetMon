    "elements": {
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Saída suspeita: muitos destinos na mesma porta (48 h, amostrado)",
          "description": "Clientes falando com dezenas de destinos em portas de SSH, Telnet, SMTP, SMB, RDP, SQL, SIP ou MikroTik (8291) costumam estar infectados ou sendo usados para spam/varredura — é o que gera denúncias. NetFlow 1:2048: o número real de destinos é maior.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "orbymon-mysql"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawSql": "SELECT IF(subscriber_ip='',local_ip,subscriber_ip) AS 'Assinante / IP',local_ip AS 'IP público',remote_port AS 'Porta',protocol AS 'Proto',COUNT(DISTINCT remote_ip) AS 'Destinos distintos',SUM(flows) AS 'Fluxos' FROM orby_flow_minute WHERE source='huawei' AND direction='out' AND bucket_utc>=UTC_TIMESTAMP()-INTERVAL 2 DAY AND remote_port IN (22,23,25,445,465,587,1433,2323,3306,3389,5060,5900,8291) AND (${ip:sqlstring}='' OR local_ip=${ip:sqlstring} OR subscriber_ip=${ip:sqlstring}) GROUP BY 1,local_ip,remote_port,protocol HAVING COUNT(DISTINCT remote_ip)>=20 ORDER BY COUNT(DISTINCT remote_ip) DESC LIMIT 100"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.3.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "zebraStriping": false
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "color-background"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": []
              }
            }
          },
          "transparent": true
        }
      },
