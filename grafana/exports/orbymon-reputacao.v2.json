                      "id": "byName",
                      "options": "Pico pps"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "pps"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Pico taxa"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bps"
