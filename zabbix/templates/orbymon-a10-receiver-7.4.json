        "template": "Template OrbyMon A10 Receiver",
        "name": "OrbyMon - A10 Receiver Health",
        "description": "15 metricas numericas agregadas enviadas opcionalmente via zabbix_sender. Sem historico de mapeamentos NAT, sem reinicializacao do rsyslog.",
        "groups": [
          {
            "name": "Templates/OrbyMon"
          }
        ],
        "items": [
          {
            "uuid": "d6f283d8a45d43b2879a4a1000000004",
            "name": "Estado geral (0=operacional 1=atencao 2=critico 3=inconclusivo)",
            "type": "TRAP",
            "key": "orbymon.a10.health.state",
            "history": "14d",
            "trends": "90d",
            "tags": [
              {
                "tag": "component",
                "value": "cgnat-syslog"
              }
            ],
            "triggers": [
              {
                "uuid": "d6f283d8a45d43b2879a4a1000000014",
                "expression": "last(/Template OrbyMon A10 Receiver/orbymon.a10.health.state)=2",
                "name": "Alerta critico: receptor A10",
                "priority": "HIGH",
                "description": "Health check operacional do receptor, nao prova integridade de eventos NAT."
              },
              {
                "uuid": "d6f283d8a45d43b2879a4a1000000015",
                "expression": "last(/Template OrbyMon A10 Receiver/orbymon.a10.health.state)=1",
                "name": "Atencao: receptor A10",
                "priority": "WARNING",
                "description": "Health check operacional do receptor, nao prova integridade de eventos NAT."
              },
              {
                "uuid": "d6f283d8a45d43b2879a4a1000000016",
                "expression": "last(/Template OrbyMon A10 Receiver/orbymon.a10.health.state)=3",
                "name": "Monitoramento A10 inconclusivo",
                "priority": "WARNING",
                "description": "Health check operacional do receptor, nao prova integridade de eventos NAT."
              },
              {
                "uuid": "d6f283d8a45d43b2879a4a1000000017",
                "expression": "nodata(/Template OrbyMon A10 Receiver/orbymon.a10.health.state,10m)=1",
                "name": "Nenhum dado novo de saude A10 em 10 minutos",
                "priority": "HIGH",
                "description": "Health check operacional do receptor, nao prova integridade de eventos NAT."
              }
